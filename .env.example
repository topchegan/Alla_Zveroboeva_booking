# Порт сервера (по умолчанию 3000)
PORT=3000

# Путь к файлу базы SQLite (по умолчанию data/app.db). Файл базы не коммитится.
DB_PATH=data/app.db

# Администратор создаётся при первом запуске. Если не заданы — админ не создаётся.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Пароль демо-клиентов (Ирина, Ольга, Мария). Если не задан — демо-данные не создаются.
DEMO_PASSWORD=
